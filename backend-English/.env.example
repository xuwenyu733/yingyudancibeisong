DATABASE_URL="file:./dev.db"
AUTH_SECRET="dev-word-quest-secret"
ADMIN_AUTH_SECRET="dev-word-quest-admin-secret"
PORT=3010

# 配齐后，小程序 uni.login 的 code 会走真实微信登录；不配则继续开发登录
WECHAT_APPID=
WECHAT_SECRET=
# 强制开发登录（即使已配置 AppID）
# WECHAT_DEV_LOGIN=1

# 订阅消息模板 ID（字段默认映射 thing1/thing2，需与你申请的模板一致）
WECHAT_SUBSCRIBE_TEMPLATE_ID=

# ===== 微信支付 V3（配齐后 createOrder 走 JSAPI；不配则自动 mock）=====
# WECHAT_MCH_ID=1900000000
# WECHAT_MCH_SERIAL_NO=证书序列号
# WECHAT_API_V3_KEY=32位APIv3密钥
# WECHAT_PAY_NOTIFY_URL=https://你的域名/api/pay/wechat/notify
# 私钥二选一：
# WECHAT_MCH_PRIVATE_KEY_PATH=/absolute/path/apiclient_key.pem
# WECHAT_MCH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 平台公钥（验回调）二选一；开发可临时 WECHAT_PAY_SKIP_NOTIFY_VERIFY=1
# WECHAT_PLATFORM_PUBLIC_KEY_PATH=/absolute/path/wechatpay_platform.pem
# WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# WECHAT_PAY_SKIP_NOTIFY_VERIFY=1
